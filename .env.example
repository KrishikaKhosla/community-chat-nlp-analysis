# Only needed for --source live (pulling from a real Discord channel).
# Not needed for --source dataset (the default).
#
# How to get a token:
#   1. Go to https://discord.com/developers/applications -> New Application
#   2. Go to the "Bot" tab -> Add Bot -> enable "Message Content Intent"
#   3. Copy the bot token below
#   4. Go to "OAuth2 > URL Generator" -> check scope "bot" and permissions
#      "View Channels" + "Read Message History" -> open the generated URL
#      and invite the bot to a server you have access to
#   5. In Discord, enable Developer Mode (User Settings > Advanced), then
#      right-click the channel you want to analyze -> "Copy Channel ID"
#      (pass this as --channel-id)
DISCORD_BOT_TOKEN=your_bot_token_here
